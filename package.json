{
  "name": "tally-to-json",
  "version": "1.8.1",
  "description": "Simple, clean TDL and XML extraction and manipulation tools for Tally",
  "type": "module",
  "main": "src/index.js",
  "module": "./src/index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://keshavsoft.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/tally-to-json"
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/tally-to-json/issues"
  },
  "dependencies": {
    "select-json-by-json": "^1.3.1",
    "tally-clean-response": "^1.2.1",
    "tally-xml-tdl": "^1.21.1"
  }
}